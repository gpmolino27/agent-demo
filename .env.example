# Copie para ".env.local" e preencha os valores reais.
#   cp .env.example .env.local

# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Chaves do projeto no Langfuse (Settings > API Keys, dentro do projeto
# criado no Langfuse self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# URL do seu Langfuse self-hosted
LANGFUSE_BASEURL=https://langfuse-web-production-e419.up.railway.app

# --- Login (usuário único) ---
AUTH_EMAIL=voce@exemplo.com
AUTH_PASSWORD=escolha-uma-senha-forte
# Segredo usado para assinar o cookie de sessão. Gere com: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Caminho do arquivo SQLite (histórico de conversas). Em produção, aponte
# para um diretório com volume persistente (ex: /data/app.db no Railway).
DATABASE_PATH=./data/app.db
